from typing import Callable, Optional, Tuple

_Limits = Tuple[Optional[float], Optional[float]]
_Components = Tuple[float, float, float]
_Tunings = Tuple[float, float, float]

def _clamp(value: Optional[float], limits: _Limits) -> Optional[float]: ...

class PID(object):
    Kp: float
    Ki: float
    Kd: float
    setpoint: float
    sample_time: Optional[float]
    man_in: Optional[float]
    proportional_on_measurement: bool
    differential_on_measurement: bool
    error_map: Optional[Callable[[float], float]]
    time_fn: Callable[[], float]
    def __init__(
        self,
        Kp: float = ...,
        Ki: float = ...,
        Kd: float = ...,
        setpoint: float = ...,
        sample_time: Optional[float] = ...,
        output_limits: _Limits = ...,
        auto_mode: bool = ...,
        man_in: Optional[float] = ...,
        tracking_mode: bool = ...,
        Tt: Optional[float] = ...,
        proportional_on_measurement: bool = ...,
        differential_on_measurement: bool = ...,
        error_map: Optional[Callable[[float], float]] = ...,
        time_fn: Optional[Callable[[], float]] = ...,
        starting_output: float = ...,
    ) -> None: ...
    def __call__(
        self, input_: float, dt: Optional[float] = ..., track_in_: Optional[float] = ...
    ) -> Optional[float]: ...
    def __repr__(self) -> str: ...
    @property
    def components(self) -> _Components: ...
    @property
    def holding(self) -> bool: ...
    @property
    def tunings(self) -> _Tunings: ...
    @tunings.setter
    def tunings(self, tunings: _Tunings) -> None: ...
    @property
    def Tt(self) -> Optional[float]: ...
    @Tt.setter
    def Tt(self, Tt: Optional[float]) -> None: ...
    @property
    def tracking_tuning(self) -> Optional[float]: ...
    @tracking_tuning.setter
    def tracking_tuning(self, Tt: Optional[float]) -> None: ...
    @property
    def auto_mode(self) -> bool: ...
    @auto_mode.setter
    def auto_mode(self, enabled: bool) -> None: ...
    def set_auto_mode(self, enabled: bool, last_output: Optional[float] = ...) -> None: ...
    @property
    def tracking_mode(self) -> bool: ...
    @tracking_mode.setter
    def tracking_mode(self, enabled: bool) -> None: ...
    def set_tracking_mode(self, enabled: bool) -> None: ...
    @property
    def output_limits(self) -> _Limits: ...
    @output_limits.setter
    def output_limits(self, limits: _Limits) -> None: ...
    def reset(self) -> None: ...
